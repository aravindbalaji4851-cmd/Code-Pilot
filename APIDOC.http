# ACCOUNTS API CALLS ========================

# api call for creating admin user
###
POST http://127.0.0.1:8000/accounts/admin/register/
Content-Type: application/json

{
    "username":"student001",
    "email":"student001@gmail.com",
    "password":"student01@123",
    "phone":"1134121891"
}

# api call for creating student user
###
POST http://127.0.0.1:8000/accounts/student/register/
Content-Type: application/json

{
    "username":"student10",
    "email": "student1@gmail.com",
    "password":"student10@123",
    "phone":"12345678100"
}

# api call for token generation 
###
POST http://127.0.0.1:8000/accounts/token/
Content-Type: application/json

{
    "username":"student10",
    "password":"student10@123"
}


# EXAMS API CALLS =============================

# api call for listing assessments
###
GET http://127.0.0.1:8000/exams/all/
Accept: application/json
Authorization: Token d2652d263a4f12d1970b46188288b05d7272c7d2

# api call for creating assessments
###
POST http://127.0.0.1:8000/exams/add/
Content-Type: application/json
Authorization: Token YOUR_TOKEN_HERE

{
    "title": "Database Management Assessment",
    "batch": "Database Batch B",
    "language": "python",
    "exam_date": "2026-10-31",
    "duration": 2,
    "start_time": "12:00:00",
    "status": "published"
}

# api call for retrieveing specific assessments 
###
GET http://127.0.0.1:8000/exams/assessments/1/
Accept: application/json
Authorization: Token d2652d263a4f12d1970b46188288b05d7272c7d2

# api call for updating assessments
###
PUT http://127.0.0.1:8000/exams/assessments/1/
Content-Type: application/json
Authorization: Token YOUR_TOKEN_HERE

{
    "title": "Python Programming Assessment",
    "batch": "Python Django Batch 2026",
    "language": "python",
    "exam_date": "2026-10-25",
    "duration": 3,
    "start_time": "10:00:00",
    "status": "published"
}

# api call for deleting assessments 
###
DELETE http://127.0.0.1:8000/exams/assessments/7/
Accept: application/json
Authorization: Token YOUR_TOKEN_HERE


# QUESTION ENDPOINTS ===========================

# api call for creating question
###
POST http://127.0.0.1:8000/problem/assessment/1/question/
Content-Type: application/json
Authorization: Token d2652d263a4f12d1970b46188288b05d7272c7d2

{
    "title":"write a program to find prime",
    "description":"write a program to find prime as function",
    "score":10,
    "sample_input":"num=5",
    "sample_output":"True"

}

# api call for retrieving  question
###
GET http://127.0.0.1:8000/problem/question/2/
Accept: application/json
Authorization: Token d2652d263a4f12d1970b46188288b05d7272c7d2

# api call for updating question
###
PUT http://127.0.0.1:8000/problem/question/1/
Content-Type: application/json
Authorization: Token d2652d263a4f12d1970b46188288b05d7272c7d2

{
  "title": "write a program to add two numberes",
  "description": "write a program to add two numberes without using sum function",
  "score": 5,
  "sample_input": "num1=15, num2=15",
  "sample_output": "result=30"
}

# api call for deleting question
###
DELETE http://127.0.0.1:8000/problem/question/2/
Accept: application/json
Authorization: Token d2652d263a4f12d1970b46188288b05d7272c7d2



