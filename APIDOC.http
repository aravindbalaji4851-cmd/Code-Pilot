# ACCOUNTS API CALLS ========================

# api call for creating admin user
###
POST http://127.0.0.1:8000/accounts/admin/register/
Content-Type: application/json

{
    "username":"admin1",
    "email":"admin1@gmail.com",
    "password":"admin1@123",
    "phone":"1234567891"
}

# api call for creating student user
###
POST http://127.0.0.1:8000/accounts/student/register/
Content-Type: application/json

{
    "username":"student1",
    "email": "student1@gmail.com",
    "password":"student1@123",
    "phone":"1234567810"
}

# api call for token generation 
###
POST http://127.0.0.1:8000/accounts/token/
Content-Type: application/json

{
    "username":"admin1",
    "password":"admin1@123"
}


# EXAMS API CALLS =============================

# api call for listing assessments
###
GET http://127.0.0.1:8000/exams/all/
Accept: application/json
Authorization: Token YOUR_TOKEN_HERE

# api call for creating assessments
###
POST http://127.0.0.1:8000/exams/add/
Content-Type: application/json
Authorization: Token YOUR_TOKEN_HERE

{
    "title": "Database Management Assessment",
    "batch": "Database Batch B",
    "language": "python",
    "exam_date": "2026-10-31",
    "duration": 2,
    "start_time": "12:00:00",
    "status": "published"
}

# api call for retrieveing specific assessments 
###
GET http://127.0.0.1:8000/exams/assessments/4/
Accept: application/json
Authorization: Token YOUR_TOKEN_HERE

# api call for updating assessments
###
PUT http://127.0.0.1:8000/exams/assessments/1/
Content-Type: application/json
Authorization: Token YOUR_TOKEN_HERE

{
    "title": "Python Programming Assessment",
    "batch": "Python Django Batch 2026",
    "language": "python",
    "exam_date": "2026-10-25",
    "duration": 3,
    "start_time": "10:00:00",
    "status": "published"
}

# api call for deleting assessments 
###
DELETE http://127.0.0.1:8000/exams/assessments/7/
Accept: application/json
Authorization: Token YOUR_TOKEN_HERE